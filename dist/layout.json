      "files": [
        "src/layouts/Page.astro",
        "src/components/HomeContent.astro",
        "src/components/HomeHero.astro",
        "src/styles/site.css"
      ]
    },
    {
      "url": "https://krigsvoldtheme.dev/",
      "repository": "krigsvoldtheme/krigsvoldtheme",
      "commit": "880bdd2bd8430bbdfd8d728faaae0c21199540b1",
