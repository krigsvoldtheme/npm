{
  "schemaVersion": 1,
  "primitives": [
    "container",
    "stack",
    "cluster",
    "grid",
    "sidebar",
    "split"
  ],
  "compositions": [
    "article",
    "landing",
    "documentation"
  ],
  "defaults": {
    "space": "regular",
    "columns": 3,
    "splitRatio": "equal",
    "sidebarSide": "end"
  },
  "tokens": {
    "layout-gap": "2rem",
    "layout-gap-small": "1rem",
    "layout-gap-large": "3rem",
    "layout-sidebar-width": "20rem",
    "layout-main-min": "30rem",
    "layout-grid-min": "20rem",
    "layout-split-min": "22rem",
    "layout-section-space": "clamp(4.5rem, 8vw, 7.5rem)"
  },
  "sources": [
    {
      "url": "https://krigsvold.org/",
